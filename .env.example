# Local standalone mode: bash scripts/up-local.sh
# Safe to run exactly as it ships.

# Host interface and port for the marketing/download site.
SITE_BIND=127.0.0.1
SITE_PORT=8087

# Host interface and port for the WebSocket relay.
# The apps connect to ws://127.0.0.1:8090/ws with these values.
RELAY_BIND=127.0.0.1
RELAY_PORT=8090

# Absolute URL the site is served from; baked into the page at build time.
PUBLIC_SITE_URL=http://localhost:8087

# 1 only when a reverse proxy sets X-Forwarded-For in front of the relay.
RELAY_TRUST_PROXY=0
