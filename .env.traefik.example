# Local shared-Traefik mode: copy to .env.traefik and run
# bash scripts/up-local-traefik.sh

# Hostnames Traefik routes. Anything under .localhost resolves to 127.0.0.1
# without a hosts-file entry on Linux, macOS and Windows.
SITE_HOST=remote-desktop.localhost
RELAY_HOST=relay.remote-desktop.localhost

# hobby-traefik listens on 8085 locally, so the public URL carries the port.
PUBLIC_SITE_URL=http://remote-desktop.localhost:8085

# Traefik sets X-Forwarded-For, so the relay should trust it.
RELAY_TRUST_PROXY=1
