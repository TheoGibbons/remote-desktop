# LIVE values. Copy to .env, then edit.

# Which LIVE path this instance uses:
#   0 = standalone, this stack publishes its own host ports, you supply TLS
#   1 = behind the shared hobby-traefik proxy on the traefik-public network
USE_TRAEFIK=1

# --- USE_TRAEFIK=0 only (standalone) --------------------------------------
# 0.0.0.0 publishes to every interface; the EC2 security group is what
# restricts who can reach these ports.
SITE_BIND=0.0.0.0
SITE_PORT=80
RELAY_BIND=0.0.0.0
RELAY_PORT=8090

# 1 only when you put your own reverse proxy in front of the relay.
RELAY_TRUST_PROXY=0

# --- USE_TRAEFIK=1 only (shared proxy) ------------------------------------
# Public hostnames. Both need a DNS A record pointing at this instance.
SITE_HOST=www.remote-desktop.co
RELAY_HOST=relay.remote-desktop.co

# --- Both paths -----------------------------------------------------------
# Absolute URL the site is served from; baked into the page at build time.
PUBLIC_SITE_URL=https://www.remote-desktop.co
