<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingEnd="12dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/filesToolbar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            app:navigationContentDescription="@string/files_back"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="?attr/colorOnSurface"
            app:title="@string/files_title"
            app:titleTextAppearance="?attr/textAppearanceTitleMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/filesUpload"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:contentDescription="@string/files_upload_description"
            android:enabled="false"
            android:text="@string/files_upload"
            app:icon="@drawable/ic_upload"
            app:iconSize="18dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/filesUp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/files_up"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_up"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/filesPath"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:ellipsize="start"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:paddingStart="0dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:text="@string/files_this_pc"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textDirection="ltr" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/filesSort"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:icon="@drawable/ic_sort"
            app:iconPadding="6dp"
            app:iconSize="18dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/filesLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:indeterminate="true"
        android:visibility="invisible" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- The activity restores the file anchor after the asynchronous folder reply. -->
        <ListView
            android:id="@+id/filesList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@color/rd_outline_variant"
            android:dividerHeight="1dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:saveEnabled="false" />

        <TextView
            android:id="@+id/filesEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/files_empty"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/filesStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Shown while a download or upload from this screen is running. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/filesCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/files_cancel_description"
            android:text="@string/files_cancel"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
