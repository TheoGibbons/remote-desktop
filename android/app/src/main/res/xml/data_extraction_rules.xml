<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same rules as backup_rules.xml, also for
     moving to a new phone, where the old one may still be in use. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="install.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="install.xml" />
    </device-transfer>
</data-extraction-rules>
