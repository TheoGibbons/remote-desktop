<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Run the actual capture loop with deterministic idle capture and codec
         doubles, without a GPU, relay connection, or changing the desktop. -->
    <Compile Include="../RemoteDesktopWin/ScreenStreamer.cs" Link="ScreenStreamer.cs" />
    <Compile Include="../RemoteDesktopWin/ViewRegions.cs" Link="ViewRegions.cs" />
  </ItemGroup>
</Project>
