<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Run the actual capture loop with deterministic idle capture and codec
         doubles, without a GPU, relay connection, or changing the desktop. -->
    <Compile Include="../RemoteDesktopWin/ScreenStreamer.cs" Link="ScreenStreamer.cs" />
    <Compile Include="../RemoteDesktopWin/ViewRegions.cs" Link="ViewRegions.cs" />
    <Compile Include="../RemoteDesktopWin/FrameMailbox.cs" Link="FrameMailbox.cs" />
    <!-- The PC viewer's zoom and pan arithmetic, and which keys full screen takes from Windows. -->
    <Compile Include="../RemoteDesktopWin/PcViewport.cs" Link="PcViewport.cs" />
    <Compile Include="../RemoteDesktopWin/FullScreenKeys.cs" Link="FullScreenKeys.cs" />
  </ItemGroup>
</Project>
