<Window x:Class="RemoteDesktopWin.TransfersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transfers" Height="440" Width="520" MinWidth="380" MinHeight="260"
        Background="{StaticResource RdBackgroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource RdScrollBar}"/>

        <!-- Rows aren't selected: each has its own cancel button. -->
        <Style x:Key="TransferRowStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RdBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransferProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Foreground" Value="{StaticResource RdPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource RdOutlineBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="2" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Indicator" CornerRadius="2" Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource RdCard}" Padding="6">
            <Grid>
                <ListBox x:Name="TransferListBox" Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource TransferRowStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Arrow}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource RdPrimaryBrush}"
                                           VerticalAlignment="Center" Margin="2,0,14,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                               Foreground="{StaticResource RdOnSurfaceBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="Detail" Text="{Binding Detail}" Style="{StaticResource RdCaption}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    <ProgressBar Style="{StaticResource TransferProgress}" Margin="0,6,0,2"
                                                 Value="{Binding Percent, Mode=OneWay}"
                                                 Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource RdIconButton}"
                                        Margin="8,0,0,0" VerticalAlignment="Center" Click="Cancel_Click"
                                        ToolTip="Cancel this file"
                                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasFailed}" Value="True">
                                    <Setter TargetName="Detail" Property="Foreground" Value="{StaticResource RdDangerBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Files you send or receive show here" HorizontalAlignment="Center"
                           VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource RdCaption}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count, ElementName=TransferListBox}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Uploads and downloads with every device, this session" Style="{StaticResource RdCaption}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,12,0"/>
            <Button x:Name="ClearButton" Grid.Column="1" Content="Clear finished" Style="{StaticResource RdTextButton}"
                    Click="Clear_Click"/>
        </Grid>
    </Grid>
</Window>
