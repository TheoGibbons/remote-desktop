<Window x:Class="RemoteDesktopWin.FileExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone files" Height="540" Width="640"
        AllowDrop="True" PreviewDragEnter="Window_DragOver" PreviewDragOver="Window_DragOver"
        PreviewDragLeave="Window_DragLeave" PreviewDrop="Window_Drop">
    <Grid Margin="10" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Left" Content="⬆ Up" Padding="10,3" Click="Up_Click"/>
            <Button DockPanel.Dock="Right" Content="⟳" Padding="10,3" Margin="6,0,0,0" Click="Refresh_Click"/>
            <TextBox x:Name="PathBox" Margin="6,0" VerticalContentAlignment="Center" KeyDown="PathBox_KeyDown"/>
        </DockPanel>

        <ListView x:Name="EntryList" Grid.Row="1" Margin="0,8" SelectionMode="Single" MouseDoubleClick="Entry_DoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="360" DisplayMemberBinding="{Binding Display}"/>
                    <GridViewColumn Header="Size" Width="110" DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn Header="Modified" Width="130" DisplayMemberBinding="{Binding MTimeText}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <DockPanel Grid.Row="2">
            <Button Content="⬇ Download" Padding="10,4" Click="Download_Click"/>
            <Button Content="⬆ Upload files to phone..." Padding="10,4" Margin="8,0,0,0" Click="Upload_Click"
                    ToolTip="You can also drag files onto this window"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </DockPanel>

        <Grid x:Name="DropOverlay" Grid.RowSpan="3" Visibility="Collapsed" IsHitTestVisible="False">
            <Rectangle Fill="#EBF2F8FF" Stroke="#2B7CD3" StrokeThickness="2" StrokeDashArray="4 3" RadiusX="6" RadiusY="6"/>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Foreground="#1F5FA8" FontSize="16">
                ⬆ Drop files to upload<LineBreak/>
                <Run FontSize="12" Text="They're saved to the phone's Downloads folder"/>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
