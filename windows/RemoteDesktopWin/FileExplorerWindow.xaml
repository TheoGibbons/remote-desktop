<Window x:Class="RemoteDesktopWin.FileExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone files" Height="540" Width="640">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Left" Content="⬆ Up" Padding="10,3" Click="Up_Click"/>
            <Button DockPanel.Dock="Right" Content="⟳" Padding="10,3" Margin="6,0,0,0" Click="Refresh_Click"/>
            <TextBox x:Name="PathBox" Margin="6,0" VerticalContentAlignment="Center" KeyDown="PathBox_KeyDown"/>
        </DockPanel>

        <ListView x:Name="EntryList" Grid.Row="1" Margin="0,8" SelectionMode="Single" MouseDoubleClick="Entry_DoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="360" DisplayMemberBinding="{Binding Display}"/>
                    <GridViewColumn Header="Size" Width="110" DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn Header="Modified" Width="130" DisplayMemberBinding="{Binding MTimeText}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <DockPanel Grid.Row="2">
            <Button Content="⬇ Download" Padding="10,4" Click="Download_Click"/>
            <Button Content="⬆ Upload file to phone..." Padding="10,4" Margin="8,0,0,0" Click="Upload_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </DockPanel>
    </Grid>
</Window>
