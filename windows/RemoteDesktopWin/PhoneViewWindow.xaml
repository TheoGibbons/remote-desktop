<Window x:Class="RemoteDesktopWin.PhoneViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone" Height="760" Width="400" MinWidth="280" MinHeight="160"
        Background="Transparent" Focusable="True"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewTextInput="Window_PreviewTextInput">
    <!-- The title bar is this window's own (see WindowCaption), so it can hold
         the "⋯" button. Nothing in it or in the menu may take the keyboard
         focus: while the window is focused, every key is typed into the phone. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="BarRow" Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- No background, so the system's frame shows through and the bar is
             one colour with the minimise, maximise and close buttons that
             Windows draws in the space kept free at the right. -->
        <Grid x:Name="TitleBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="SystemButtonsColumn" Width="138"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Margin="12,0,8,0" VerticalAlignment="Center"
                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       TextTrimming="CharacterEllipsis" FontSize="12" Foreground="White">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button x:Name="MenuButton" Grid.Column="1" Content="&#xE712;"
                    Style="{StaticResource RdCaptionButton}"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    AutomationProperties.Name="Phone menu"
                    Click="MenuButton_Click"
                    MouseEnter="MenuButton_MouseEnter" MouseLeave="MenuButton_MouseLeave"/>
        </Grid>

        <!-- The picture host. Other layers go above the picture in here (the
             unlock overlay and captions, then the Stats readout), so nothing
             may assume the picture is its only child. -->
        <Grid x:Name="PictureHost" Grid.Row="1" Background="#111">
            <Image x:Name="ScreenImage" Stretch="Uniform"
                   MouseLeftButtonDown="Screen_MouseDown" MouseLeftButtonUp="Screen_MouseUp"
                   MouseMove="Screen_MouseMove" MouseWheel="Screen_MouseWheel"
                   MouseUp="Screen_OtherButtonUp"/>
        </Grid>

        <!-- The "⋯" menu. A Popup rather than a ContextMenu, which would take
             the focus and close on every click. Clicking a row leaves it open,
             so Back can be pressed several times. -->
        <Popup x:Name="MenuPopup" PlacementTarget="{Binding ElementName=MenuButton}" Placement="Custom"
               StaysOpen="True" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
            <Border x:Name="MenuCard" Margin="8,2,8,10" Padding="4" MinWidth="280" SnapsToDevicePixels="True"
                    Background="{StaticResource RdSurfaceBrush}" CornerRadius="10"
                    BorderBrush="{StaticResource RdOutlineBrush}" BorderThickness="1"
                    MouseEnter="MenuCard_MouseEnter" MouseLeave="MenuCard_MouseLeave">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.16"/>
                </Border.Effect>
                <StackPanel>
                    <UniformGrid Rows="1">
                        <Button x:Name="BackButton" Style="{StaticResource RdMenuButton}" Tag="back"
                                HorizontalContentAlignment="Center" Padding="8" Click="MenuAction_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 10.5,2 L 3.5,7 L 10.5,12 Z" Width="14" Height="14"
                                      StrokeThickness="1.4" StrokeLineJoin="Round" VerticalAlignment="Center"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Back" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="HomeButton" Style="{StaticResource RdMenuButton}" Tag="homebtn"
                                HorizontalContentAlignment="Center" Padding="8" Click="MenuAction_Click">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="12" Height="12" Margin="1" StrokeThickness="1.4" VerticalAlignment="Center"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Home" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="RecentsButton" Style="{StaticResource RdMenuButton}" Tag="recents"
                                HorizontalContentAlignment="Center" Padding="8" Click="MenuAction_Click">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="11" Height="11" Margin="1.5" RadiusX="2" RadiusY="2"
                                           StrokeThickness="1.4" VerticalAlignment="Center"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Recents" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    <!-- Rows that need an updated phone go here when they are
                         built: media volume, then rotation, each under a
                         separator of its own. -->
                    <Separator Style="{StaticResource RdMenuSeparator}"/>
                    <Button x:Name="NotificationsButton" Style="{StaticResource RdMenuButton}" Tag="notifications"
                            Content="Notifications" Click="MenuAction_Click"/>
                    <!-- And here: Quick settings, Screenshot, Lock screen. -->
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
