<Window x:Class="RemoteDesktopWin.PhoneViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone" Height="760" Width="400" Background="#111">
    <Grid>
        <Image x:Name="ScreenImage" Stretch="Uniform"
               MouseLeftButtonDown="Screen_MouseDown" MouseLeftButtonUp="Screen_MouseUp"
               MouseMove="Screen_MouseMove" MouseWheel="Screen_MouseWheel"
               MouseUp="Screen_OtherButtonUp"/>
    </Grid>
</Window>
