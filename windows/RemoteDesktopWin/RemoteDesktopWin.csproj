<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RemoteDesktopWin</AssemblyName>
    <RootNamespace>RemoteDesktopWin</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <DefaultRelayServerUrl Condition="'$(DefaultRelayServerUrl)' == ''">wss://relay.remote-desktop.co/ws</DefaultRelayServerUrl>
    <!-- Pointer-based pixel compare in ScreenStreamer's dirty-rect diff. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WFAC010 / WFO0003 (renamed in the .NET 10 analyzers): the WinForms
         analyzer flags the manifest DPI settings, but this is a WPF app
         (WinForms is only referenced for the tray NotifyIcon) and WPF takes its
         DPI awareness from the manifest. -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="DefaultRelayServerUrl" Value="$(DefaultRelayServerUrl)" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms injects these as global usings, which collides with the
         WPF Application/Point/MouseEventArgs types. WinForms types (tray icon)
         are fully qualified in code instead. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- DXGI Desktop Duplication capture (ScreenStreamer/DxgiCaptureSource). -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
