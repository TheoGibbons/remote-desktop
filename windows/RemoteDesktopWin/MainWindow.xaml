<Window x:Class="RemoteDesktopWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Desktop" Height="800" Width="620" MinWidth="560" MinHeight="600"
        Background="{StaticResource RdBackgroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18" MaxWidth="700">

            <!-- ============ Session ID card ============ -->
            <Border Style="{StaticResource RdCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SESSION ID" Style="{StaticResource RdOverline}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Use this on all your devices" Style="{StaticResource RdCaption}"
                                   VerticalAlignment="Center" Margin="10,0,8,0"/>
                        <Button Grid.Column="2" x:Name="GenKeyButton" Style="{StaticResource RdIconButton}"
                                Content="&#xE72C;" Click="GenKey_Click"
                                ToolTip="Generate a strong session ID (click Save &amp; connect to apply)"/>
                    </Grid>

                    <TextBox x:Name="SessionKeyBox" Style="{StaticResource RdTextBox}" Margin="0,8,0,0"
                             FontFamily="Consolas" FontSize="14"/>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="SERVER URL" Style="{StaticResource RdOverline}" Margin="2,0,0,4"/>
                        <TextBox x:Name="ServerUrlBox" Style="{StaticResource RdTextBox}"/>
                    </StackPanel>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ElevateButton" Content="Restart as administrator"
                                Style="{StaticResource RdOutlinedButton}" HorizontalAlignment="Left"
                                Click="Elevate_Click"
                                ToolTip="Windows (UIPI) blocks remote input to elevated windows like Task Manager unless this app also runs elevated."/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="QrButton" Content="Show QR code" Style="{StaticResource RdOutlinedButton}"
                                    Click="Qr_Click"
                                    ToolTip="Show a QR code the phone can scan to copy these settings"/>
                            <Button x:Name="ConnectButton" Content="Save &amp; connect" Style="{StaticResource RdPrimaryButton}"
                                    Margin="8,0,0,0" Click="Connect_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ Connection status card ============ -->
            <Border Style="{StaticResource RdCard}" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="{StaticResource RdDangerBrush}"
                             VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusTitle" Text="Not connected" Style="{StaticResource RdCardTitle}"/>
                        <TextBlock x:Name="StatusSubtitle" Text="Save &amp; connect to join the session"
                                   Style="{StaticResource RdCaption}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Devices card ============ -->
            <Border Style="{StaticResource RdCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Devices" Style="{StaticResource RdCardTitle}"/>

                    <ItemsControl x:Name="DevicesList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Fill="{Binding Dot}"
                                             VerticalAlignment="Center" Margin="2,0,12,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource RdOnSurfaceBrush}"/>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource RdCaption}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Approve" Style="{StaticResource RdPrimaryButton}" Padding="12,5"
                                                Visibility="{Binding ShowApprove, Converter={StaticResource BoolToVis}}"
                                                Click="RowApprove_Click"/>
                                        <Button Content="Deny" Style="{StaticResource RdDangerTextButton}" Margin="4,0,0,0"
                                                Visibility="{Binding ShowApprove, Converter={StaticResource BoolToVis}}"
                                                Click="RowDeny_Click"/>
                                        <Button Content="View" Style="{StaticResource RdOutlinedButton}" Padding="12,5" Margin="4,0,0,0"
                                                Visibility="{Binding ShowView, Converter={StaticResource BoolToVis}}"
                                                Click="RowView_Click"
                                                ToolTip="View and control this device"/>
                                        <Button Content="Files" Style="{StaticResource RdOutlinedButton}" Padding="12,5" Margin="4,0,0,0"
                                                Visibility="{Binding ShowView, Converter={StaticResource BoolToVis}}"
                                                Click="RowFiles_Click"
                                                ToolTip="Browse this device's files"/>
                                        <Button Content="&#xE712;" Style="{StaticResource RdIconButton}" Margin="4,0,0,0"
                                                Foreground="{StaticResource RdOnSurfaceVariantBrush}"
                                                Visibility="{Binding ShowMore, Converter={StaticResource BoolToVis}}"
                                                Click="RowMore_Click"
                                                ToolTip="More options"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="DevicesEmptyText" Style="{StaticResource RdCaption}" Margin="0,10,0,2"
                               Text="No devices yet — a device that joins with this session ID appears here."/>
                </StackPanel>
            </Border>

            <!-- ============ This Computer card ============ -->
            <Border Style="{StaticResource RdCard}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="This Computer" Style="{StaticResource RdCardTitle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="OwnCodeText" Style="{StaticResource RdCaption}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   ToolTip="Shown on other devices when this one asks to pair — approve only if the codes match."/>
                    </Grid>
                    <TextBlock Text="DEVICE NAME" Style="{StaticResource RdOverline}" Margin="2,12,0,4"/>
                    <TextBox x:Name="DeviceNameBox" Style="{StaticResource RdTextBox}"
                             LostFocus="DeviceName_LostFocus"
                             ToolTip="How this computer appears on paired devices — applied when you leave the field"/>
                </StackPanel>
            </Border>

            <!-- ============ Access card ============ -->
            <Border Style="{StaticResource RdCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Allow Paired Devices" Style="{StaticResource RdCardTitle}"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="View and control this computer" FontSize="13"
                                       Foreground="{StaticResource RdOnSurfaceBrush}"/>
                            <TextBlock Text="Screen, mouse and keyboard" Style="{StaticResource RdCaption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="AllowStreamCheck" Style="{StaticResource RdSwitch}"
                                  Checked="Consent_Changed" Unchecked="Consent_Changed"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource RdOutlineBrush}" Margin="0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Browse and transfer files" FontSize="13"
                                       Foreground="{StaticResource RdOnSurfaceBrush}"/>
                            <TextBlock Text="Paired devices can browse this computer's files" Style="{StaticResource RdCaption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="AllowFilesCheck" Style="{StaticResource RdSwitch}"
                                  Checked="Consent_Changed" Unchecked="Consent_Changed"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource RdOutlineBrush}" Margin="0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Start with Windows" FontSize="13"
                                       Foreground="{StaticResource RdOnSurfaceBrush}"/>
                            <TextBlock Text="Keeps this PC reachable; the app lives in the tray" Style="{StaticResource RdCaption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="StartupCheck" Style="{StaticResource RdSwitch}"
                                  Checked="Startup_Changed" Unchecked="Startup_Changed"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TransferText" Style="{StaticResource RdCaption}" Margin="4,10,4,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
